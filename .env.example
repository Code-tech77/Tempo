# Copy this file to .env and replace the placeholder with your Gemini API key.
GEMINI_API_KEY=replace-with-your-google-ai-api-key
GEMINI_MODEL=gemini-3.5-flash
# Frontend transport is configured in a root .env file and read by Vite.
# Use mock only when intentionally previewing fixtures; API is the default.
# VITE_TEMPO_TRANSPORT=mock
# VITE_TEMPO_MOCK_STATE=success
# VITE_TEMPO_API_URL=
